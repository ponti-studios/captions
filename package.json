{
  "name": "@ponti-studios/captions",
  "version": "0.1.0",
  "description": "Live captions that follow the audio: pure pacing logic, a React hook, and components for React and React Native.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./native": { "types": "./dist/native.d.ts", "default": "./dist/native.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "esbuild demo/main.tsx --bundle --outfile=demo/out.js --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --servedir=demo --serve=4173",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
