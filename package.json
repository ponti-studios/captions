{
  "name": "@ponti-studios/captions",
  "version": "0.1.0",
  "description": "Live captions that follow the audio: pure pacing logic, a React hook, and components for React and React Native.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "esbuild demo/main.tsx --bundle --outfile=demo/out.js --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --servedir=demo --serve=4173",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "predemo": "tailwindcss -i demo/app.src.css -o demo/app.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.58.0"
  }
}
